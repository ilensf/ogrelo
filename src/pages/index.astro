---
import Base from '../layouts/Base.astro';
import Directorio from '../components/Directorio.vue';
import { obtenerRestaurantes } from '../lib/datos';

const restaurantes = obtenerRestaurantes();
const base = import.meta.env.BASE_URL;
---

<Base titulo="Veggie Coruña: restaurantes vegetarianos y veganos en A Coruña">
  <div class="contenedor pantalla">
    <div class="encabezado">
      <h1>Dónde comer vegetariano y vegano en A&nbsp;Coruña</h1>
      <p>Con horario, precio, teléfono para reservar y cómo llegar sin coche.</p>
    </div>
    <Directorio client:load restaurantes={restaurantes} base={base} />
  </div>
</Base>

<style>
  .pantalla {
    display: flex;
    flex-direction: column;
    padding-top: 1rem;
    padding-bottom: 1rem;
    /* la aplicación ocupa la ventana: la lista y el mapa tienen su propio desplazamiento */
    height: calc(100dvh - var(--alto-cabecera));
    min-height: 560px;
  }
  .encabezado {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.15rem 1.25rem;
    margin-bottom: 0.75rem;
  }
  h1 {
    font-size: clamp(1.3rem, 3.2vw, 2rem);
    letter-spacing: -0.035em;
  }
  .encabezado p {
    color: var(--tinta-suave);
  }
  @media (max-width: 720px) {
    .encabezado p {
      display: none;
    }
  }
</style>
