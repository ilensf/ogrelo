---
import Base from '../../layouts/Base.astro';
import Medidor from '../../components/Medidor.vue';
import Mapa from '../../components/Mapa.vue';
import EstadoAhora from '../../components/EstadoAhora.vue';
import { formatearTelefono, infoTransporte, obtenerRestaurantes } from '../../lib/datos';
import { DIAS, DIETAS, DIFICULTAD_APARCAR, NOMBRE_DIA, PRECIOS, SERVICIOS } from '../../lib/etiquetas';
import { formatearFranjas } from '../../lib/horario';
import type { RestauranteVista } from '../../lib/tipos';

export function getStaticPaths() {
  return obtenerRestaurantes().map((r) => ({ params: { id: r.id }, props: { r } }));
}

const { r } = Astro.props as { r: RestauranteVista };
const base = import.meta.env.BASE_URL;
const transporte = infoTransporte();
const destino = encodeURIComponent(`${r.nombre}, ${r.direccion}`);
const rutaBus = `https://www.google.com/maps/dir/?api=1&destination=${destino}&travelmode=transit`;
const DIA_SCHEMA = { lun: 'Monday', mar: 'Tuesday', mie: 'Wednesday', jue: 'Thursday', vie: 'Friday', sab: 'Saturday', dom: 'Sunday' } as const;
const datosEstructurados = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  name: r.nombre,
  description: r.resumen,
  servesCuisine: r.cocina,
  priceRange: '€'.repeat(r.precio),
  address: { '@type': 'PostalAddress', streetAddress: r.direccion, addressLocality: 'A Coruña', addressCountry: 'ES' },
  ...(r.telefono && { telephone: r.telefono }),
  ...(r.web && { url: r.web }),
  ...(r.coords && { geo: { '@type': 'GeoCoordinates', latitude: r.coords.lat, longitude: r.coords.lng } }),
  openingHoursSpecification: DIAS.flatMap((d) =>
    (r.horario[d] ?? []).map(([abre, cierra]) => ({
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: DIA_SCHEMA[d],
      opens: abre,
      ...(cierra && { closes: cierra }),
    })),
  ),
};
const capital = (s: string) => s[0].toUpperCase() + s.slice(1);
---

<Base titulo={`${r.nombre}: opciones vegetarianas y veganas en A Coruña | Veggie Coruña`} descripcion={r.resumen}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(datosEstructurados).replace(/</g, '\\u003c')} />
  <div class={`contenedor ficha d-${r.dieta}`}>
    <a class="volver" href={base}>
      <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M20 11H7.800l5.600-5.600L12 4l-8 8 8 8 1.400-1.400L7.800 13H20z" /></svg>
      Todos los restaurantes
    </a>

    <header class="ficha-cabecera">
      <div class={`dieta d-${r.dieta}`}>
        <Medidor dieta={r.dieta} tamano="l" />
        <div>
          <p class="dieta-nombre">{DIETAS[r.dieta].nombre}</p>
          <p class="dieta-desc">{DIETAS[r.dieta].descripcion}</p>
        </div>
      </div>
      <h1>{r.nombre}</h1>
      <p class="meta">
        {r.cocina.map(capital).join(', ')}. {r.barrioNombre}. {PRECIOS[r.precio]} ({'€'.repeat(r.precio)}).
      </p>
      <EstadoAhora client:load horario={r.horario} />
    </header>

    <div class="acciones">
      {
        r.telefono && (
          <a class="boton boton--principal" href={`tel:${r.telefono}`}>
            Llamar para reservar: {formatearTelefono(r.telefono)}
          </a>
        )
      }
      {r.web && <a class="boton" href={r.web} rel="noopener" target="_blank">Web</a>}
      {r.carta && r.carta !== r.web && <a class="boton" href={r.carta} rel="noopener" target="_blank">Ver carta</a>}
      <a class="boton" href={r.enlaceMaps} rel="noopener" target="_blank">Abrir en Google Maps</a>
    </div>

    <div class="rejilla">
      <section class="bloque bloque--ancho">
        <p class="resumen">{r.resumen}</p>
        {
          r.destacados.length > 0 && (
            <>
              <h2>Qué pedir</h2>
              <ul class="destacados">
                {r.destacados.map((d) => (
                  <li>{d}</li>
                ))}
              </ul>
            </>
          )
        }
        {r.servicios.length > 0 && <p class="servicios">{r.servicios.map((s) => SERVICIOS[s]).join(', ')}.</p>}
      </section>

      <section class="bloque">
        <h2>Horario</h2>
        <table class="horario">
          <tbody>
            {
              DIAS.map((d) => (
                <tr data-dia={d}>
                  <th scope="row">{NOMBRE_DIA[d]}</th>
                  <td>{formatearFranjas(r.horario[d])}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </section>

      <section class="bloque">
        <h2>Reseñas</h2>
        {
          r.valoraciones.length > 0 ? (
            <ul class="notas">
              {r.valoraciones.map((v) => (
                <li>
                  <span class="nota">{v.nota.toLocaleString('es')}</span>
                  <span>
                    de {v.max} en {v.fuente}
                    {v.resenas && <> ({v.resenas} reseñas)</>}
                  </span>
                </li>
              ))}
            </ul>
          ) : (
            <p class="tenue">Aún no tenemos una nota de referencia para este sitio.</p>
          )
        }
        <p class="enlaces-resenas">
          Lee las opiniones completas en <a href={r.enlaceMaps} rel="noopener" target="_blank">Google Maps</a>
          {
            r.enlaces.happycow && (
              <>
                {' '}o en <a href={r.enlaces.happycow} rel="noopener" target="_blank">HappyCow</a>
              </>
            )
          }.
        </p>
        {r.precioNota && <p class="tenue">{r.precioNota}.</p>}
      </section>

      <section class="bloque">
        <h2>En bus</h2>
        {
          r.bus && r.bus.paradas.length > 0 ? (
            <ul class="paradas">
              {r.bus.paradas.map((p) => (
                <li>
                  <span class="lineas">
                    {p.lineas.map((l) => (
                      <span class="linea">{l}</span>
                    ))}
                  </span>
                  <span>
                    {p.nombre}, a {p.distancia} m
                  </span>
                </li>
              ))}
            </ul>
          ) : (
            <p class="tenue">
              {r.coords
                ? 'Las paradas cercanas se calcularán con los datos oficiales del bus urbano.'
                : 'Falta ubicar este local en el mapa para calcular sus paradas.'}
            </p>
          )
        }
        <a class="boton" href={rutaBus} rel="noopener" target="_blank">Ver ruta en transporte público</a>
        {transporte.fuente && <p class="fuente">Fuente: {transporte.fuente}.</p>}
      </section>

      <section class="bloque">
        <h2>En coche</h2>
        <p class={`aparcar aparcar--${r.aparcamiento.dificultad}`}>
          Aparcar: {DIFICULTAD_APARCAR[r.aparcamiento.dificultad].toLowerCase()}
        </p>
        <p>{r.aparcamiento.nota}</p>
        {
          r.aparcamiento.parkings.length > 0 && (
            <p class="tenue">Parkings públicos de la zona: {r.aparcamiento.parkings.join(', ')}.</p>
          )
        }
        <p class="fuente">Estimación por barrio, no por calle.</p>
      </section>

      <section class="bloque bloque--ancho bloque--mapa">
        <h2>Dónde está</h2>
        <p>{r.direccion}</p>
        {
          r.coords ? (
            <>
              <div class="mini-mapa">
                <Mapa
                  client:visible
                  puntos={[{ id: r.id, nombre: r.nombre, dieta: r.dieta, lat: r.coords.lat, lng: r.coords.lng, exactas: r.coords.exactas }]}
                  resaltado={r.id}
                  zoom={16}
                />
              </div>
              {!r.coords.exactas && <p class="tenue">Ubicación aproximada en el mapa; la dirección es la correcta.</p>}
            </>
          ) : (
            <p class="tenue">Todavía sin ubicar en el mapa.</p>
          )
        }
      </section>
    </div>
  </div>
</Base>

<style>
  .ficha {
    padding-top: 1.5rem;
  }
  .volver {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    margin-bottom: 1.25rem;
    padding: 0.5em 1em;
    font-weight: 600;
    text-decoration: none;
    background: var(--papel);
    border: 1px solid var(--linea);
    border-radius: 999px;
    box-shadow: var(--sombra);
    transition: transform 0.15s;
  }
  .volver:hover {
    transform: translateX(-3px);
  }
  .ficha-cabecera {
    display: grid;
    gap: 0.75rem;
    max-width: 52rem;
  }
  .ficha-cabecera :global(.hoja) {
    background: var(--grelo-vacio);
  }
  .ficha-cabecera :global(.hoja.llena) {
    background: var(--d-punto);
  }
  .dieta {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }
  .dieta-nombre {
    font-weight: 700;
    color: var(--d-texto);
  }
  .dieta-desc {
    font-size: 0.9rem;
    color: var(--tinta-suave);
  }
  h1 {
    font-size: clamp(2.3rem, 6.5vw, 4.2rem);
    letter-spacing: -0.045em;
    line-height: 1;
  }
  .meta {
    font-size: 1.1rem;
    color: var(--tinta-suave);
  }
  .acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 1.5rem 0 2rem;
  }
  .rejilla {
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 820px) {
    .rejilla {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .bloque--ancho {
      grid-column: 1 / -1;
    }
  }
  .bloque {
    display: grid;
    gap: 0.75rem;
    align-content: start;
    justify-items: start;
    padding: 1.5rem;
    background: var(--papel);
    border: 1px solid var(--linea);
    border-radius: var(--radio);
    box-shadow: none;
  }
  .bloque > * {
    max-width: 68ch;
  }
  h2 {
    font-size: 1.25rem;
    letter-spacing: -0.02em;
  }
  .resumen {
    font-size: 1.15rem;
  }
  .destacados {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .destacados li {
    padding: 0.25em 0.75em;
    border-radius: 999px;
    background: var(--d-fondo);
    color: var(--d-texto);
    font-weight: 500;
  }
  .servicios,
  .tenue,
  .fuente {
    color: var(--tinta-suave);
  }
  .fuente {
    font-size: 0.85rem;
  }
  .horario {
    width: 100%;
    border-collapse: collapse;
  }
  .horario th,
  .horario td {
    padding: 0.35rem 0;
    text-align: left;
    border-bottom: 1px solid var(--linea);
  }
  .horario th {
    font-weight: 500;
    width: 40%;
  }
  .horario :global(tr.hoy) {
    font-weight: 700;
  }
  .horario :global(tr.hoy th)::after {
    content: ' (hoy)';
    font-weight: 400;
    color: var(--tinta-suave);
  }
  .notas {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .notas li {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }
  .nota {
    font-size: 2.6rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .paradas {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }
  .paradas li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .lineas {
    display: inline-flex;
    gap: 0.25rem;
  }
  .linea {
    min-width: 2.2em;
    padding: 0.1em 0.4em;
    text-align: center;
    font-weight: 700;
    color: var(--papel);
    background: var(--mar);
    border-radius: 8px;
  }
  .aparcar {
    font-weight: 700;
  }
  .aparcar--3 {
    color: var(--xesta);
  }
  .bloque--mapa {
    justify-items: stretch;
  }
  .mini-mapa {
    height: 340px;
    max-width: none;
  }
</style>
