---
import PaginaDirectorio from '../../components/PaginaDirectorio.astro';
import { obtenerCiudades } from '../../lib/datos';

export function getStaticPaths() {
  return obtenerCiudades().map((c) => ({ params: { ciudad: c.id } }));
}
---

<PaginaDirectorio idioma="es" ciudadActual={Astro.params.ciudad} />
