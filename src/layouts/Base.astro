---
import '../styles/global.css';
import { IDIOMA_DEFECTO, IDIOMAS, raizIdioma, textos, type Idioma } from '../i18n';

interface Props {
  titulo: string;
  descripcion?: string;
  idioma: Idioma;
}
const { titulo, idioma } = Astro.props;
const t = textos(idioma);
const descripcion = Astro.props.descripcion ?? t.sitio.descripcion;
const base = import.meta.env.BASE_URL;
const raiz = raizIdioma(base, idioma);
// Ruta dentro del idioma actual, para enlazar a la misma página en el otro.
const resto = Astro.url.pathname.slice(raiz.length).replace(/([^/])$/, '$1/');
const urlEn = (i: Idioma) => `${raizIdioma(base, i)}${resto}`;
const absoluta = (i: Idioma) => new URL(urlEn(i), Astro.site).href;
const enInicio = resto === '';
const enAcerca = resto === 'acerca/';
const canonica = absoluta(idioma);
---

<!doctype html>
<html lang={idioma}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={descripcion} />
    <meta name="theme-color" content="#faf9f6" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{titulo}</title>
    <link rel="canonical" href={canonica} />
    {IDIOMAS.map((i) => <link rel="alternate" hreflang={i} href={absoluta(i)} />)}
    <link rel="alternate" hreflang="x-default" href={absoluta(IDIOMA_DEFECTO)} />
    <meta property="og:site_name" content="O Grelo" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={t.localeOg} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonica} />
    <meta name="twitter:card" content="summary" />
    <slot name="head" />
    {
      idioma === IDIOMA_DEFECTO && (
        <script is:inline define:vars={{ destino: urlEn('es') }}>
          // Si la persona eligió castellano, no se le muestra el idioma por defecto.
          try {
            if (localStorage.getItem('idioma') === 'es') location.replace(destino + location.search + location.hash);
          } catch (e) {}
        </script>
      )
    }
    <script is:inline>
      // Tema antes de pintar: el elegido por la persona o, si no, el del sistema.
      try {
        var t = localStorage.getItem('tema');
        if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="saltar visualmente-oculto" href="#contenido">{t.sitio.saltar}</a>
    <header class="cabecera">
      <div class="contenedor cabecera-fila">
        <a class="marca" href={raiz} aria-label={t.sitio.inicio}>
          <svg viewBox="0 0 32 32" width="30" height="30" aria-hidden="true">
            <path d="M16 3C9 9 6 15 8 22c1.5 5 5 7 8 7s6.5-2 8-7c2-7-1-13-8-19z" fill="var(--grelo)" />
            <path d="M16 9v19" stroke="var(--granito)" stroke-width="1.8" fill="none" />
          </svg>
          <span class="marca-texto">O Grelo</span>
        </a>
        <nav aria-label={t.sitio.navPrincipal}>
          <a class="solo-ancho" href={raiz} aria-current={enInicio ? 'page' : undefined}>{t.sitio.restaurantes}</a>
          <a href={`${raiz}acerca/`} aria-current={enAcerca ? 'page' : undefined}>{t.sitio.comoSeHace}</a>
          <div class="idiomas" role="group" aria-label={t.sitio.idioma}>
            {
              IDIOMAS.map((i) => (
                <a href={urlEn(i)} hreflang={i} lang={i} data-idioma={i} title={textos(i).nombreIdioma} aria-current={i === idioma ? 'true' : undefined}>
                  {i.toUpperCase()}
                </a>
              ))
            }
          </div>
          <button type="button" class="tema" id="alternar-tema" aria-label={t.sitio.tema} title={t.sitio.tema}>
            <svg class="icono-luna" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M20.7 14.5A8.5 8.5 0 0 1 9.5 3.3a9 9 0 1 0 11.2 11.2z" /></svg>
            <svg class="icono-sol" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><circle cx="12" cy="12" r="4.5" fill="currentColor" /><path stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M12 2v2.5M12 19.500V22M2 12h2.500M19.500 12H22M4.900 4.900l1.800 1.800M17.300 17.300l1.800 1.800M4.900 19.100l1.800-1.800M17.300 6.700l1.800-1.800" /></svg>
          </button>
        </nav>
      </div>
    </header>
    <main id="contenido">
      <slot />
    </main>
    <footer class="pie">
      <div class="contenedor pie-rejilla">
        <p>{t.sitio.pieDatos}</p>
        <p>{t.sitio.pieMapa} <a href={`${raiz}acerca/`}>{t.sitio.pieGuia}</a>.</p>
      </div>
    </footer>
    <script is:inline>
      document.getElementById('alternar-tema')?.addEventListener('click', function () {
        var nuevo = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = nuevo;
        try { localStorage.setItem('tema', nuevo); } catch (e) {}
      });
      // Al cambiar de idioma se recuerda la elección y se conservan los filtros de la URL.
      document.querySelectorAll('[data-idioma]').forEach(function (a) {
        a.addEventListener('click', function () {
          try { localStorage.setItem('idioma', a.dataset.idioma); } catch (e) {}
          a.href = a.pathname + location.search + location.hash;
        });
      });
    </script>
  </body>
</html>

<style>
  .saltar:focus {
    position: fixed !important;
    top: 8px;
    left: 8px;
    width: auto;
    height: auto;
    clip: auto;
    padding: 0.5em 1em;
    background: var(--tinta);
    color: var(--papel);
    z-index: 2000;
    border-radius: 999px;
  }
  .cabecera {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: color-mix(in srgb, var(--granito) 88%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--linea);
  }
  .cabecera-fila {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--alto-cabecera);
    gap: 1rem;
  }
  .marca {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 1.4rem;
    font-weight: 700;
    letter-spacing: -0.04em;
    text-decoration: none;
  }
  nav {
    display: flex;
    gap: 0.25rem;
  }
  nav a {
    padding: 0.45em 0.95em;
    border-radius: 999px;
    font-weight: 500;
    text-decoration: none;
    transition: background 0.15s;
  }
  nav a:hover {
    background: var(--granito-hondo);
  }
  .idiomas {
    display: inline-flex;
    align-items: center;
    margin-left: 0.25rem;
    padding: 2px;
    background: var(--papel);
    border: 1px solid var(--linea);
    border-radius: 999px;
  }
  nav .idiomas a {
    padding: 0.3em 0.6em;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--tinta-suave);
  }
  nav .idiomas a[aria-current='true'] {
    background: var(--acento);
    color: var(--sobre-acento);
  }
  nav a[aria-current='page'] {
    background: var(--acento-claro);
    color: var(--acento);
    font-weight: 600;
  }
  .tema {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    margin-left: 0.25rem;
    color: var(--tinta);
    background: var(--papel);
    border: 1px solid var(--linea);
    border-radius: 50%;
    cursor: pointer;
    transition: background 0.15s, border-color 0.15s;
  }
  .tema:hover {
    border-color: var(--tinta-suave);
  }
  /* se muestra el icono del modo al que se cambiará */
  .icono-sol {
    display: none;
  }
  :global(:root[data-theme='dark']) .icono-sol {
    display: block;
  }
  :global(:root[data-theme='dark']) .icono-luna {
    display: none;
  }
  nav a {
    white-space: nowrap;
  }
  @media (max-width: 480px) {
    .marca-texto,
    .solo-ancho {
      display: none;
    }
    nav a {
      padding: 0.4em 0.7em;
      font-size: 0.92rem;
    }
  }
  .pie {
    border-top: 1px solid var(--linea);
    padding: 1.75rem 0 2.5rem;
    font-size: 0.88rem;
    color: var(--tinta-suave);
  }
  .pie-rejilla {
    display: grid;
    gap: 0.5rem;
  }
  @media (min-width: 820px) {
    .pie-rejilla {
      grid-template-columns: 2fr 1fr;
      gap: 3rem;
    }
  }
  .pie a {
    color: var(--tinta);
  }
</style>
