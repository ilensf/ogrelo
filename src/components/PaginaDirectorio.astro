---
import Base from '../layouts/Base.astro';
import Directorio from './Directorio.vue';
import { raizIdioma, textos, type Idioma } from '../i18n';
import { esTienda } from '../lib/etiquetas';
import { obtenerCiudades, obtenerRestaurantes } from '../lib/datos';

interface Props {
  idioma: Idioma;
  /** Clave de la ciudad; sin ella, la página muestra toda Galicia. */
  ciudadActual?: string;
}
const { idioma, ciudadActual } = Astro.props;
const t = textos(idioma);
const raiz = raizIdioma(import.meta.env.BASE_URL, idioma);
const ciudades = obtenerCiudades();
const todos = obtenerRestaurantes(idioma, ciudadActual);
const restaurantes = todos.filter((r) => !esTienda(r.dieta));
const tiendas = todos.filter((r) => esTienda(r.dieta));
const nombreCiudad = ciudades.find((c) => c.id === ciudadActual)?.nombre;
const lugar = nombreCiudad ? t.enLugar(nombreCiudad) : '';

const puros = restaurantes.filter((r) => r.dieta === 'vegano' || r.dieta === 'vegetariano').length;
const titulo = nombreCiudad ? t.ciudad.titulo(lugar) : t.portada.titulo;
const descripcion = nombreCiudad ? t.ciudad.descripcion(lugar) : undefined;
const encabezado = nombreCiudad ? t.ciudad.encabezado(lugar) : t.portada.encabezado;
---

<Base idioma={idioma} titulo={titulo} descripcion={descripcion}>
  <div class="contenedor pantalla">
    <div class="encabezado">
      <h1>{encabezado}</h1>
      <p>{t.portada.subtitulo}</p>
    </div>
    {
      ciudades.length > 1 && (
        <nav class="ciudades" aria-label={t.portada.ciudades}>
          <a href={raiz} aria-current={ciudadActual ? undefined : 'page'}>{t.portada.todaGalicia} ({ciudades.reduce((n, c) => n + c.total, 0)})</a>
          {ciudades.map((c) => (
            <a href={`${raiz}${c.id}/`} aria-current={c.id === ciudadActual ? 'page' : undefined}>{c.nombre} ({c.total})</a>
          ))}
        </nav>
      )
    }
    <Directorio client:load restaurantes={todos} base={raiz} idioma={idioma} />
  </div>
  <section class="contenedor otros">
    <h2>{t.portada.guiaTitulo}</h2>
    <p>{nombreCiudad ? t.ciudad.resumen(lugar, restaurantes.length, puros) : t.portada.guiaTexto(restaurantes.length, ciudades.length)}</p>
    {
      !nombreCiudad && (
        <>
          <h3>{t.portada.explorar}</h3>
          <ul>
            {ciudades.map((c) => (
              <li>
                <a href={`${raiz}${c.id}/`}>{c.nombre}</a>
                <span>{t.portada.nSitios(c.total)}</span>
              </li>
            ))}
          </ul>
        </>
      )
    }
  </section>
  {
    tiendas.length > 0 && (
      <section class="contenedor otros">
        <h2>{t.portada.tiendasTitulo}</h2>
        <p>{t.portada.tiendasTexto}</p>
        <ul>
          {tiendas.map((r) => (
            <li>
              <a href={`${raiz}restaurante/${r.id}/`}>{r.nombre}</a>
              <span>{ciudadActual ? r.direccion.split(',')[0] : r.ciudadNombre}</span>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Base>

<style>
  .pantalla {
    display: flex;
    flex-direction: column;
    padding-top: 1rem;
    padding-bottom: 1rem;
    /* la aplicación ocupa la ventana: la lista y el mapa tienen su propio desplazamiento */
    height: calc(100dvh - var(--alto-cabecera));
    min-height: 560px;
  }
  .encabezado {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.15rem 1.25rem;
    margin-bottom: 0.6rem;
  }
  h1 {
    font-size: clamp(1.3rem, 3.2vw, 2rem);
    letter-spacing: -0.035em;
  }
  .encabezado p {
    color: var(--tinta-suave);
  }
  .ciudades {
    display: flex;
    flex: none;
    gap: 0.35rem;
    margin-bottom: 0.65rem;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .ciudades a {
    flex: none;
    padding: 0.25em 0.8em;
    font-size: 0.92rem;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    border: 1px solid var(--linea);
    border-radius: 999px;
    background: var(--papel);
  }
  .ciudades a:hover {
    border-color: var(--tinta-suave);
  }
  .ciudades a[aria-current='page'] {
    background: var(--acento-claro);
    border-color: var(--acento);
    color: var(--acento);
    font-weight: 600;
  }
  .otros {
    padding-top: 2rem;
    padding-bottom: 2.5rem;
  }
  .otros h2 {
    font-size: 1.25rem;
    letter-spacing: -0.02em;
  }
  .otros p {
    margin: 0.3rem 0 1rem;
    color: var(--tinta-suave);
  }
  .otros h3 {
    margin: 1.25rem 0 0.6rem;
    font-size: 1rem;
  }
  .otros ul {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
    gap: 0.6rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .otros li span {
    display: block;
    font-size: 0.88rem;
    color: var(--tinta-suave);
  }
  @media (max-width: 720px) {
    .encabezado p {
      display: none;
    }
  }
</style>
